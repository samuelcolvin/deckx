{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**"]
  },
  "formatter": {
    "formatWithErrors": true,
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 119
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useValidAnchor": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useUniqueElementIds": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "noRestrictedImports": "error"
      },
      "nursery": { "preset": "none" }
    }
  },
  "css": { "formatter": { "quoteStyle": "single" } },
  "javascript": {
    "formatter": {
      "trailingCommas": "all",
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      "includes": ["src/styles/base.css", "src/hljs.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off",
            "noShorthandPropertyOverrides": "off"
          },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "formatter": { "expand": "never" }
    }
  ]
}
